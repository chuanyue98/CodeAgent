# Woodpecker CI Token
# 从 Woodpecker CI 获取你的个人访问令牌
WOODPECKER_TOKEN=your_token_here

# GitHub Token
# 运行 gh auth token 获取，用于容器内 gh 命令授权
GITHUB_TOKEN=your_github_token_here

# ── CodeAgent 运行时配置 ─────────────────────────────────────────────
# 以下变量在真正需要偏离默认行为时才设置，日常使用无需在 .env 里写任何一个。
# 命名约定：CA_ 前缀仅用于 CodeAgent 自身的配置项；上面两个第三方服务凭证
# （WOODPECKER_TOKEN/GITHUB_TOKEN）保留其原生变量名，不加前缀。

# 让 `ca ui` 启动/接管一个 Vite dev server（用于前端热更新开发），而不是
# 直接 serve `web/frontend/dist/` 里已构建好的产物。
# CA_UI_DEV=1

# Web UI（`ca ui`）绑定的监听地址，默认 127.0.0.1（仅本机可访问）。
# 容器化部署时常设为 0.0.0.0 以便外部访问。
# CA_UI_HOST=0.0.0.0

# 固定 Web UI 的访问 token，替代自动生成的 ~/.codeagent/ui-token。
# 容器部署应显式设置：临时文件系统里自动生成的 token 每次重启都会变。
# 未设置时用 `ca ui --show-token` 查看当前 token。
# CA_UI_TOKEN=<a-long-random-secret>

# 设为 0/off 可关闭 Web UI 的 token 校验（Host 与 Origin 校验仍然生效）。
# 仅当前置了一层负责认证的反向代理时才可使用——否则等于把本机 shell 权限
# 开放给任何能访问该端口的对象。
# CA_UI_AUTH=off

# Web UI 额外允许的 Host 头（逗号分隔），用于通过真实域名访问的部署。
# `*` 表示接受任意 Host，会关闭 DNS rebinding 防护，仅在前置代理已校验
# Host 时使用。
# CA_UI_ALLOWED_HOSTS=codeagent.internal

# 覆盖 config.json 的读写路径，默认是项目根目录下的 config.json。
# CA_CONFIG_PATH=/path/to/config.json

# 已结束的任务运行记录与日志文件保留多少天，默认 30，设为 0 表示永久保留。
# 无论多旧，最近 200 次运行始终保留。清理在 `ca ui` / 任务服务启动时执行一次。
# CA_RUN_RETENTION_DAYS=30

# 设置后，首次在未注册目录运行引擎命令时不再打印"请用 ca project add 注册"
# 的提示（脚本化/非交互场景常用）。
# CA_SKIP_AUTO_REGISTER=1

# 打开 skill/hook/plugin/prompt 各扫描器的调试输出（哪些候选路径被扫描到、
# 为什么某个资源被跳过等）。
# CA_DEBUG=1

# 覆盖后台任务运行时使用的资源分组（默认取 config.json 里已注册项目对应的
# group），一般由 TaskRunner 内部设置，通常不需要手动指定。
# CA_PROJECT_GROUP=work

# 覆盖任务模板目录，默认是 resource_root 下的 tasks/。
# CA_TASKS_ROOT=/path/to/tasks

# 以下几个主要供内部工具链/测试使用，正常开发不需要设置：
# CA_E2E（Playwright E2E 专用，开启后挂载仅测试用的 /api/__e2e_reset 路由）、
# CA_AGENT_GATEWAY_FAKE（用 fake adapter 跑 Agent Gateway，供测试隔离）、
# CA_ROOT_DIR（覆盖 prompts 路由解析的项目根目录）、
# CA_AGENT_LEGACY_FALLBACK（强制旧版 Chat 走 CLI 直连而非 Agent Gateway）、
# CODEAGENT_RESOURCE_ROOT（覆盖资源包根目录，命名上是历史遗留，未跟随
# CA_ 前缀约定）。
